MMO_PORT=7777
MMO_TICK_RATE=20
MMO_CONNECTION_KEY=local-dev
MMO_DB_PROVIDER=sqlite
MMO_DB=Data Source=data/mmo.db
MMO_MIGRATIONS_PATH=db/sqlite
MMO_WORLD_WIDTH_TILES=128
MMO_WORLD_HEIGHT_TILES=128
MMO_STEP_COOLDOWN_MS=140
# AOI radius is measured in tiles.
MMO_INTEREST_RADIUS=40
MMO_MAX_VISIBLE_ENTITIES=150
# distributed spreads new/legacy-spawn characters through the central hub; clustered keeps worst-case all-visible stress measurable.
MMO_SPAWN_DISTRIBUTION=distributed
# Off by default. Set to 1 and optionally name a watched player to trace movement hitches/steps.
MMO_DEBUG_MOVEMENT=0
MMO_DEBUG_MOVEMENT_WATCH=
MMO_DEBUG_MOVEMENT_HITCH_MULTIPLIER=1.5
MMO_DEBUG_MOVEMENT_TICK_DURATION_MS=15
