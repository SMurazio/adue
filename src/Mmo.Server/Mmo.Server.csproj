<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseAppHost>false</UseAppHost>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteNetLib" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Mmo.Shared\Mmo.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Monster TYPE data manifest (P0): shipped to the output dir so the server loads it from
         <output>/Content/monsters.json at startup. PreserveNewest so an edit re-copies on build.
         None+CopyToOutputDirectory also propagates transitively to projects that reference this one
         (e.g. Mmo.Server.Tests), so the parity test can read the SAME shipped file from its output. -->
    <None Include="Content\monsters.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- ECOLOGY E1: the region data manifest, same convention as monsters.json above (loaded from
         <output>/Content/ecology.json at startup; PreserveNewest so an edit re-copies on build; propagates
         transitively to Mmo.Server.Tests so a parity test can read the SAME shipped file). -->
    <None Include="Content\ecology.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
