{
  // Monster TYPE data manifest (P0 of the monster-behavior architecture, docs/monster-behavior-design.md).
  // This is the AUTHORITATIVE runtime source: the server loads this loose file from
  // <output>/Content/monsters.json at startup; edit it + restart the server to change monsters with no
  // code build. If this file is missing or fails to parse the server falls back to the code-seeded
  // defaults in MonsterTypeRegistry (the safety net) — and the shipped slime below is byte-for-byte
  // identical to that code seed (a parity test pins this so the two can never silently drift).
  //
  // SCHEMA = the MonsterType fields (stats + AI tuning + hop feel + loot) plus the composition selectors
  // `locomotionId` (P1, the id of this type's locomotion "body"; "hop"/"glide" registered today) and
  // `behaviorId` (P3, the id of this type's "brain"; "basicRoamer"/"skirmisher" registered today) — an
  // unknown id falls back loud-but-safe to the default — plus `abilityIds` (P5, the action-executor abilities
  // this type composes; "charge" is the one primitive today) + its charge* tuning. The remaining selector
  // (visualId) arrives in a later phase and will extend this schema; do not add it yet. Optional fields may
  // be omitted and fall back to the field default; every tunable is clamped to the same bounds the F1 live
  // tuning uses.
  "types": [
    {
      "id": "slime",
      "displayName": "Slime",
      "lootTableId": "slime_loot",
      "locomotionId": "hop",
      "behaviorId": "basicRoamer",
      "maxHealth": 100,
      "moveSpeedMultiplier": 0.6,
      "roamRadius": 4,
      "pauseMinMs": 2000,
      "pauseMaxMs": 5000,
      "aggroRadius": 6,
      "chaseLeash": 12,
      "attackDamage": 10,
      "attackCooldownMs": 1000,
      "attackRangeUnits": 1.5,
      "hopDistanceUnits": 1.5,
      "hopHeightUnits": 0.5,
      "hopAirborneMs": 300,
      "hopDelayMs": 400,
      "respawnMs": 5000
    },
    {
      // MONSTER-BEHAVIOR P2/P4 (docs/monster-behavior-design.md): the GLIDER that WALKS continuously (locomotionId
      // "glide") instead of hopping AND, as of P4, runs its OWN brain (behaviorId "skirmisher"): it roams / chases /
      // melees like the slime but FLEES when wounded (fleeHealthPct 0.3 = glides away once below 30% HP instead of
      // attacking). The keep-distance/kiting half of "skirmisher" waits for P5's ranged ability. Spawn it with
      // `/monster gnoll`. lootTableId "" = drops nothing (no loot table authored yet — do NOT invent one).
      //
      // The HOP knobs (hopDistanceUnits / hopHeightUnits / hopAirborneMs / hopDelayMs) are OMITTED — they default and
      // are irrelevant to a glider EXCEPT that StepMonsterAi still derives this type's no-progress-watchdog timeout
      // window from (hopAirborneMs + hopDelayMs) even for a glider (a minor P2 wart noted in the design; a cleaner
      // per-locomotion cadence is a later refinement). The defaults (300 + 400 ms) give a sane watchdog window.
      // moveSpeedMultiplier 0.9 IS the glider's walk speed (it seeds SpeedUnitsPerSecond, which GlideLocomotion reads).
      //
      // MONSTER-BEHAVIOR P5: the gnoll gets its first ABILITY — a CHARGE (a fast forward dash through the shared action
      // executor to close the gap to its target). abilityIds composes "charge"; the charge* knobs tune it: it dashes
      // chargeDistanceUnits forward when the target is OUT of attack range but within chargeTriggerRangeUnits, no more
      // often than every chargeCooldownMs (the executor enforces the cooldown). Behavior-specific data (clamped on load,
      // not a live F1 knob). The charge MOTION replicates via the same dense action-airborne path the hop uses (no
      // protocol change); the charge ANIMATION is P6.
      //
      // MONSTER-BEHAVIOR P6 (docs/monster-behavior-design.md): the PLACEHOLDER per-type VISUAL — a data-authored tint +
      // scale replicated on spawn (EntitySpawn, protocol v41) and applied by the client, so the gnoll renders visibly
      // DISTINCT from the slime with NO art assets. renderTint "#B5651D" = a brown/orange the client modulates the gnoll
      // render by; renderScale 1.4 = clearly bigger. The SLIME omits both → white + 1.0 → visually unchanged. This is the
      // replicated hook where real per-type models/animations replace the client-side tint/scale mapping later.
      "id": "gnoll",
      "displayName": "Gnoll",
      "lootTableId": "",
      "locomotionId": "glide",
      "behaviorId": "skirmisher",
      "renderTint": "#B5651D",
      "renderScale": 1.4,
      "abilityIds": ["charge"],
      "chargeCooldownMs": 4000,
      "chargeDistanceUnits": 4.0,
      "chargeTriggerRangeUnits": 7.0,
      "maxHealth": 200,
      "moveSpeedMultiplier": 0.9,
      "roamRadius": 5,
      "aggroRadius": 8,
      "chaseLeash": 16,
      "attackDamage": 20,
      "attackCooldownMs": 1200,
      "attackRangeUnits": 1.5,
      "fleeHealthPct": 0.3
    }
  ]
}
