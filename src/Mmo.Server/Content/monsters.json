{
  // Monster TYPE data manifest (P0 of the monster-behavior architecture, docs/monster-behavior-design.md).
  // This is the AUTHORITATIVE runtime source: the server loads this loose file from
  // <output>/Content/monsters.json at startup; edit it + restart the server to change monsters with no
  // code build. If this file is missing or fails to parse the server falls back to the code-seeded
  // defaults in MonsterTypeRegistry (the safety net) — and the shipped slime below is byte-for-byte
  // identical to that code seed (a parity test pins this so the two can never silently drift).
  //
  // SCHEMA = the MonsterType fields (stats + AI tuning + hop feel + loot) plus the composition selectors
  // `locomotionId` (P1, the id of this type's locomotion "body"; "hop"/"glide" registered today) and
  // `behaviorId` (P3, the id of this type's "brain"; only "basicRoamer" is registered today) — an unknown
  // id falls back loud-but-safe to the default. The remaining selectors (abilityIds / visualId) arrive in
  // later phases and will extend this schema; do not add them yet. Optional fields may
  // be omitted and fall back to the field default; every tunable is clamped to the same bounds the F1 live
  // tuning uses.
  "types": [
    {
      "id": "slime",
      "displayName": "Slime",
      "lootTableId": "slime_loot",
      "locomotionId": "hop",
      "behaviorId": "basicRoamer",
      "maxHealth": 100,
      "moveSpeedMultiplier": 0.6,
      "roamRadius": 4,
      "pauseMinMs": 2000,
      "pauseMaxMs": 5000,
      "aggroRadius": 6,
      "chaseLeash": 12,
      "attackDamage": 10,
      "attackCooldownMs": 1000,
      "attackRangeUnits": 1.5,
      "hopDistanceUnits": 1.5,
      "hopHeightUnits": 0.5,
      "hopAirborneMs": 300,
      "hopDelayMs": 400,
      "respawnMs": 5000
    },
    {
      // MONSTER-BEHAVIOR P2 (docs/monster-behavior-design.md): the first GLIDER — a monster that WALKS continuously
      // (locomotionId "glide") instead of hopping, the first VISIBLE per-type behavior difference. It keeps the
      // CURRENT brain (BasicRoamer): it roams / chases / melees exactly like the slime, just WALKING. Spawn it with
      // `/monster gnoll`. lootTableId "" = drops nothing (no loot table authored yet — do NOT invent one).
      //
      // The HOP knobs (hopDistanceUnits / hopHeightUnits / hopAirborneMs / hopDelayMs) are OMITTED — they default and
      // are irrelevant to a glider EXCEPT that StepMonsterAi still derives this type's no-progress-watchdog timeout
      // window from (hopAirborneMs + hopDelayMs) even for a glider (a minor P2 wart noted in the design; a cleaner
      // per-locomotion cadence is a later refinement). The defaults (300 + 400 ms) give a sane watchdog window.
      // moveSpeedMultiplier 0.9 IS the glider's walk speed (it seeds SpeedUnitsPerSecond, which GlideLocomotion reads).
      "id": "gnoll",
      "displayName": "Gnoll",
      "lootTableId": "",
      "locomotionId": "glide",
      "behaviorId": "basicRoamer",
      "maxHealth": 200,
      "moveSpeedMultiplier": 0.9,
      "roamRadius": 5,
      "aggroRadius": 8,
      "chaseLeash": 16,
      "attackDamage": 20,
      "attackCooldownMs": 1200,
      "attackRangeUnits": 1.5
    }
  ]
}
