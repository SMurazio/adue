{
  // Monster TYPE data manifest (P0 of the monster-behavior architecture, docs/monster-behavior-design.md).
  // This is the AUTHORITATIVE runtime source: the server loads this loose file from
  // <output>/Content/monsters.json at startup; edit it + restart the server to change monsters with no
  // code build. If this file is missing or fails to parse the server falls back to the code-seeded
  // defaults in MonsterTypeRegistry (the safety net) — and the shipped slime below is byte-for-byte
  // identical to that code seed (a parity test pins this so the two can never silently drift).
  //
  // SCHEMA = the MonsterType fields (stats + AI tuning + hop feel + loot) plus the composition selectors
  // `locomotionId` (P1, the id of this type's locomotion "body"; "hop"/"glide" registered today) and
  // `behaviorId` (P3, the id of this type's "brain"; "basicRoamer"/"skirmisher" registered today) — an
  // unknown id falls back loud-but-safe to the default — plus `abilityIds` (P5/T1, the abilities this type
  // composes; "charge" + "slam" are the primitives today) + their charge*/slam* tuning. The remaining selector
  // (visualId) arrives in a later phase and will extend this schema; do not add it yet. Optional fields may
  // be omitted and fall back to the field default; every tunable is clamped to the same bounds the F1 live
  // tuning uses.
  "types": [
    {
      // TELEGRAPH T1 (docs/ability-telegraph-sync-design.md): the slime composes the "slam" ability — its FIRST real
      // attack pattern. When its target is within attack range and the slam is off cooldown, it schedules a CIRCLE
      // telegraph of slamRadiusUnits LOCKED at the target's position at cast time, resolving slamWindupMs later
      // against positions AT the resolve tick (step out during the windup = dodged) for slamDamage, no more often
      // than every slamCooldownMs. Its instant melee (attackDamage/attackCooldownMs) is unchanged and runs between
      // slams. SLIME-SLAM ROOT+LEAP: from cast to resolve the slime is COMMITTED — rooted (no hops/chase/melee)
      // through the windup, then it LEAPS (hopDistance/hopHeight/hopAirborneMs machinery) onto the locked circle
      // center, landing exactly on the resolve tick; a cast farther than hopDistanceUnits is declined, so the
      // effective trigger range is min(attackRangeUnits, hopDistanceUnits). The values here mirror the code seed
      // byte-for-byte (the parity test pins them).
      "id": "slime",
      "displayName": "Slime",
      "lootTableId": "slime_loot",
      "locomotionId": "hop",
      "behaviorId": "basicRoamer",
      "abilityIds": ["slam"],
      "slamRadiusUnits": 2.0,
      "slamWindupMs": 1500,
      "slamDamage": 15,
      "slamCooldownMs": 4000,
      "maxHealth": 100,
      "moveSpeedMultiplier": 0.6,
      "roamRadius": 4,
      "pauseMinMs": 2000,
      "pauseMaxMs": 5000,
      "aggroRadius": 6,
      "chaseLeash": 12,
      "attackDamage": 10,
      "attackCooldownMs": 1000,
      "attackRangeUnits": 1.5,
      "hopDistanceUnits": 1.5,
      "hopHeightUnits": 0.5,
      "hopAirborneMs": 300,
      "hopDelayMs": 400,
      "respawnMs": 5000
    },
    {
      // MONSTER-BEHAVIOR P2/P4 (docs/monster-behavior-design.md): the GLIDER that WALKS continuously (locomotionId
      // "glide") instead of hopping AND, as of P4, runs its OWN brain (behaviorId "skirmisher"): it roams / chases /
      // melees like the slime but FLEES when wounded (fleeHealthPct 0.3 = glides away once below 30% HP instead of
      // attacking). The keep-distance/kiting half of "skirmisher" waits for P5's ranged ability. Spawn it with
      // `/monster gnoll`. lootTableId "" = drops nothing (no loot table authored yet — do NOT invent one).
      //
      // The HOP knobs (hopDistanceUnits / hopHeightUnits / hopAirborneMs / hopDelayMs) are OMITTED — they default and
      // are irrelevant to a glider EXCEPT that StepMonsterAi still derives this type's no-progress-watchdog timeout
      // window from (hopAirborneMs + hopDelayMs) even for a glider (a minor P2 wart noted in the design; a cleaner
      // per-locomotion cadence is a later refinement). The defaults (300 + 400 ms) give a sane watchdog window.
      // moveSpeedMultiplier 0.9 IS the glider's walk speed (it seeds SpeedUnitsPerSecond, which GlideLocomotion reads).
      //
      // MONSTER-BEHAVIOR P5: the gnoll gets its first ABILITY — a CHARGE (a fast forward dash through the shared action
      // executor to close the gap to its target). abilityIds composes "charge"; the charge* knobs tune it: it dashes
      // chargeDistanceUnits forward when the target is OUT of attack range but within chargeTriggerRangeUnits, no more
      // often than every chargeCooldownMs (the executor enforces the cooldown). Behavior-specific data (clamped on load,
      // not a live F1 knob). The charge MOTION replicates via the same dense action-airborne path the hop uses (no
      // protocol change); the charge ANIMATION is P6.
      //
      // MONSTER-BEHAVIOR P6 (docs/monster-behavior-design.md): the PLACEHOLDER per-type VISUAL — a data-authored tint +
      // scale replicated on spawn (EntitySpawn, protocol v41) and applied by the client, so the gnoll renders visibly
      // DISTINCT from the slime with NO art assets. renderTint "#B5651D" = a brown/orange the client modulates the gnoll
      // render by; renderScale 1.4 = clearly bigger. The SLIME omits both → white + 1.0 → visually unchanged. This is the
      // replicated hook where real per-type models/animations replace the client-side tint/scale mapping later.
      "id": "gnoll",
      "displayName": "Gnoll",
      "lootTableId": "",
      "locomotionId": "glide",
      "behaviorId": "skirmisher",
      "renderTint": "#B5651D",
      "renderScale": 1.4,
      "abilityIds": ["charge"],
      "chargeCooldownMs": 4000,
      "chargeDistanceUnits": 4.0,
      "chargeTriggerRangeUnits": 7.0,
      "maxHealth": 200,
      "moveSpeedMultiplier": 0.9,
      "roamRadius": 5,
      "aggroRadius": 8,
      "chaseLeash": 16,
      "attackDamage": 20,
      "attackCooldownMs": 1200,
      "attackRangeUnits": 1.5,
      "fleeHealthPct": 0.3
    },
    {
      // BOSS-1 (docs/boss-encounter-sunderer-design.md): THE SUNDERER — the duo-encounter boss, spawned/despawned by
      // the BossEncounterEngine (NOT a world/region spawner), so its respawnMs is inert. It WALKS (glide) at 2.2u/s
      // and chases with the shared basicRoamer brain. maxHealth 1200 here is the DUO baseline; the encounter engine
      // OVERRIDES it per participant count at spawn (1200 duo / 700 solo) via SpawnMonsterCore's maxHealthOverride.
      //
      // BASELINE KIT (BOSS-1 scaffold — reuses the existing ability seams, NO new telegraph shapes / NO protocol
      // change):
      //   * CLEAVE = the "slam" ability (a CIRCLE telegraph): radius 2.8u, 0.8s windup, 25 dmg, ~5s cadence, cast in
      //     melee range. NOTE (deviation): the design's Cleave is a 130-degree WEDGE, but TelegraphShape supports only
      //     Circle today — a Wedge is a shared-shape + wire-codec (protocol) change, surfaced as a fork, so BOSS-1
      //     ships a circle placeholder. The slam's root+leap makes it read as a short lunging cleave onto the target.
      //   * LUNGE = the "charge" ability (a fast forward dash out of melee range, ~8u, ~8s cadence): the gap-closer
      //     MOTION only. Its line telegraph + ~20 dmg are DEFERRED with the Wedge/Line telegraph-shape protocol work
      //     (the charge seam carries no telegraph/damage) — surfaced as a fork, not invented here.
      //
      // attackDamage 0 = NO untelegraphed chip melee (the Cleave/slam is the sole melee damage; a 0 fallthrough swing
      // is a no-op — ApplyDamage(0) changes nothing). aggro/leash are arena-wide so the boss engages any participant
      // instantly and never leashes inside the 22-tile room; roamRadius 0 = it never wanders (the engine owns it).
      // renderTint/renderScale make the boss obviously distinct + large with no art. moveSpeedMultiplier 0.55 =
      // 2.2u/s at the 4u/s base (1000/StepCooldownMs). hop* knobs size the slam-leap (reach = min(attackRange,hop)).
      "id": "sunderer",
      "displayName": "The Sunderer",
      "lootTableId": "",
      "locomotionId": "glide",
      "behaviorId": "basicRoamer",
      "renderTint": "#8A2BE2",
      "renderScale": 2.0,
      "abilityIds": ["slam", "charge"],
      "slamRadiusUnits": 2.8,
      "slamWindupMs": 800,
      "slamDamage": 25,
      "slamCooldownMs": 5000,
      "chargeCooldownMs": 8000,
      "chargeDistanceUnits": 8.0,
      "chargeTriggerRangeUnits": 8.0,
      "maxHealth": 1200,
      "moveSpeedMultiplier": 0.55,
      "roamRadius": 0.5,
      "aggroRadius": 30,
      "chaseLeash": 60,
      "attackDamage": 0,
      "attackCooldownMs": 1000,
      "attackRangeUnits": 2.8,
      "hopDistanceUnits": 2.8,
      "hopHeightUnits": 0.3,
      "hopAirborneMs": 300,
      "hopDelayMs": 400,
      "respawnMs": 5000
    },
    {
      // BOSS-2 (docs/boss-encounter-sunderer-design.md P1 HUSK): THE INTERPOSER DRONE — the Sunderer's P1 add,
      // spawned/despawned by the BossEncounterEngine (NOT a spawner; respawnMs is inert — the engine owns the 5 s
      // first-spawn / 6 s respawn cadence). It WALKS (glide) at 1.6 u/s (moveSpeedMultiplier 0.4 × the 4 u/s base) and
      // runs the minimal "interposer" brain (InterposerBehavior): each think-tick it steers to the pair's segment
      // midpoint (duo) / the boss<->player midpoint (solo) to BODY-BLOCK fusion crossings — the B1 contest. It has NO
      // attack (attackDamage 0) and does not aggro/leash (the interposer brain ignores those tunables; the small
      // aggro/roam/leash values here only satisfy the registry clamps). 40 HP, dies to anything (the tether melts it),
      // lootTableId "" = no loot/corpse. renderTint a cold steel grey + renderScale 0.7 (small, clearly an add).
      "id": "interposer",
      "displayName": "Interposer Drone",
      "lootTableId": "",
      "locomotionId": "glide",
      "behaviorId": "interposer",
      "renderTint": "#5F6A72",
      "renderScale": 0.7,
      "maxHealth": 40,
      "moveSpeedMultiplier": 0.4,
      "roamRadius": 0.5,
      "aggroRadius": 0.5,
      "chaseLeash": 0.5,
      "attackDamage": 0,
      "attackCooldownMs": 1000,
      "attackRangeUnits": 0.5,
      "respawnMs": 5000
    },
    {
      // BOSS-3 (docs/boss-encounter-sunderer-design.md P2 SUNDER): THE SPLINTER — the Sunderer's P2 ring add,
      // spawned/despawned by the BossEncounterEngine (NOT a spawner; respawnMs is inert — the engine owns the ~20 s
      // re-ring cadence + the pop). It WALKS (glide) at 1.2 u/s (moveSpeedMultiplier 0.3 × the 4 u/s base) and runs the
      // minimal "splinter" brain (SplinterBehavior): each think-tick it creeps toward the NEAREST living participant.
      // It has NO attack (attackDamage 0) and does not aggro/leash/roam (the splinter brain ignores those tunables; the
      // small values here only satisfy the registry clamps). 15 HP, dies to anything (the tether orbit-sweep clears the
      // ring — the S7 vulnerability), lootTableId "" = no loot/corpse. The POP (~12 damage + self-despawn once within
      // 1 u of a participant) is ENCOUNTER-driven, not a monster attack. renderTint a jagged bone/ash white + renderScale
      // 0.5 (small, clearly a shard swarm).
      "id": "splinter",
      "displayName": "Splinter",
      "lootTableId": "",
      "locomotionId": "glide",
      "behaviorId": "splinter",
      "renderTint": "#D8CFC0",
      "renderScale": 0.5,
      "maxHealth": 15,
      "moveSpeedMultiplier": 0.3,
      "roamRadius": 0.5,
      "aggroRadius": 0.5,
      "chaseLeash": 0.5,
      "attackDamage": 0,
      "attackCooldownMs": 1000,
      "attackRangeUnits": 0.5,
      "respawnMs": 5000
    }
  ]
}
